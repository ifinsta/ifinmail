# ifinmail environment variables — copy to .env and fill in values
# Generated by provision.sh — do not commit .env to version control
#
# Two layers (see docs/environment.md):
#   root .env           → Django runtime (local dev / CI). Uses DJANGO_* names.
#   provisioning/.env   → host provisioning (provision.sh generates it). Uses
#                         short names (SECRET_KEY, APP_DB_PASSWORD, ...).
#   docker-compose maps provisioning → runtime:
#     SECRET_KEY → DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS → ALLOWED_HOSTS,
#     APP_DB_PASSWORD → DB_PASSWORD, REDIS_PASSWORD → REDIS_URL/CELERY_BROKER_URL.
#
# Local dev quickstart:
#   cp .env.example .env
#   venv\Scripts\python -m pip install -r requirements/development.txt
#   venv\Scripts\python manage.py migrate
#   venv\Scripts\python manage.py runserver
# Set USE_SQLITE=1 for file-based dev (no Postgres/Redis needed). Unset it and
# set DB_HOST to use Postgres.

# Django
# Runtime key. Also accepts SECRET_KEY (provisioning name) as fallback — see base.py.
DJANGO_SECRET_KEY=
# development (local, USE_SQLITE) or production (deploy checks). manage.py defaults
# to development when unset; CI sets testing via pyproject.toml.
DJANGO_SETTINGS_MODULE=backend.config.settings.development
# Single source for hosts. production.py also accepts ALLOWED_HOSTS (the value
# compose injects from this key) — set only this one locally.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSS_VERSION=

# Database — unset DB_HOST (or set USE_SQLITE=1) to use db.sqlite3 for local dev.
USE_SQLITE=1
DB_NAME=ifinmail
DB_USER=ifinmail_app
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=prefer
DATABASE_URL=

# Redis (optional locally — LocMemCache is used with USE_SQLITE)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/1

# Email / Mail
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com

# Admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Security
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=
AXES_FAILURE_LIMIT=5
SECURE_HSTS_SECONDS=3600
# optional | required. "required" makes two-factor mandatory for console logins.
MFA_ENFORCEMENT=optional
# Days the audit trail is kept (minimum 30).
AUDIT_RETENTION_DAYS=365

# Sentry (optional — external forwarder; DB telemetry is the system of record)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_RATE=0.1

# Telemetry (error tracking — guaranteed local capture even without Sentry)
TELEMETRY_ENABLED=True
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_SAMPLE_WARNING=1.0

# Frontend
# Set to 0 for air-gapped installs: skips the Google Fonts CDN; the CSS font
# stack falls back to the system UI fonts.
USE_GOOGLE_FONTS=1

# Database roles (production only — generated into provisioning/.env by provision.sh)
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
DOVECOT_DB_PASSWORD=
POSTFIX_DB_PASSWORD=

# Monitoring
MONITOR_ALERT_WEBHOOK=
MONITOR_QUEUE_WARN=50
MONITOR_QUEUE_CRITICAL=200
MONITOR_CERT_WARN_DAYS=30
MONITOR_CERT_CRITICAL_DAYS=7

# Backup
BACKUP_GPG_RECIPIENT=
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPT=true
