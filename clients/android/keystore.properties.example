# Copy to keystore.properties (git-ignored) and fill in your release key.
#
# Create a key once, and back it up somewhere safe; losing it means you cannot update the app:
#   keytool -genkeypair -v -keystore ifinmail-release.jks -alias ifinmail \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to clients/android, or may be an absolute path.
storeFile=ifinmail-release.jks
storePassword=change-me
keyAlias=ifinmail
keyPassword=change-me
