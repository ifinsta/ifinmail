# Dovecot PostgreSQL authentication — ifinmail
driver = pgsql
connect = host=postgres dbname=ifinmail user=dovecot password=__DOVECOT_DB_PASSWORD__ sslmode=__PGSSLMODE__

default_pass_scheme = SHA512-CRYPT

# Password query: returns password hash and user metadata during auth
password_query = \
    SELECT u.email AS user, u.password_hash AS password, \
           'vmail' AS userdb_uid, 'vmail' AS userdb_gid, \
           '/var/mail/vhosts/%d/%n' AS userdb_home, \
           'maildir:/var/mail/vhosts/%d/%n' AS userdb_mail, \
           '*:bytes=' || COALESCE(m.quota_bytes, 0) AS userdb_quota_rule \
    FROM users u \
    LEFT JOIN domains d ON d.name = '%d' \
    LEFT JOIN mailboxes m ON m.domain_id = d.id AND m.local_part = '%n' \
    WHERE u.email = '%u' AND u.is_active = TRUE

user_query = \
    SELECT '/var/mail/vhosts/%d/%n' AS home, \
           'maildir:/var/mail/vhosts/%d/%n' AS mail, \
           5000 AS uid, 5000 AS gid, \
           '*:bytes=' || COALESCE(m.quota_bytes, 0) AS quota_rule \
    FROM users u \
    LEFT JOIN domains d ON d.name = '%d' \
    LEFT JOIN mailboxes m ON m.domain_id = d.id AND m.local_part = '%n' \
    WHERE u.email = '%u' AND u.is_active = TRUE

iterate_query = SELECT email AS user FROM users WHERE is_active = TRUE
