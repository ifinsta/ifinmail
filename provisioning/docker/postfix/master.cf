# ifinmail Postfix master.cf — service definitions
#
# service type  private unpriv  chroot  wakeup  maxproc  command + args

# These services talk to Dovecot over sockets in /var/run/dovecot (SASL and LMTP).
# They must not be chrooted: inside the chroot (/var/spool/postfix) that path does not
# exist, so SASL would fail ("no SASL authentication mechanisms", clients cannot send)
# and delivery to Dovecot would fail.
# --- Main SMTP (port 25) ---
smtp      inet  n       -       n       -       50       smtpd

# --- Submission (port 587) — authenticated clients, mandatory TLS ---
submission inet n       -       n       -       50       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
  -o smtpd_tls_wrappermode=no

# --- SMTPS (port 465) — implicit TLS for legacy clients ---
smtps     inet  n       -       n       -       50       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING

# --- Internal relay (port 10025) — the console's own email (setup links, verification) ---
# Not published in docker-compose.yml, so only containers on the ifinmail network reach it.
# The entrypoint sets this service's mynetworks to that network; until then it falls back to
# main.cf (localhost only) and refuses everyone else.
10025     inet  n       -       n       -       10       smtpd
  -o syslog_name=postfix/internal
  -o smtpd_sasl_auth_enable=no
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o milter_macro_daemon_name=ORIGINATING

# --- Local pickup ---
pickup    unix  n       -       y       60      1       pickup
cleanup   unix  n       -       y       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       y       -       -       trivial-rewrite
bounce    unix  -       -       y       -       0       bounce
defer     unix  -       -       y       -       0       bounce
trace     unix  -       -       y       -       0       bounce
verify    unix  -       -       y       -       1       verify
flush     unix  n       -       y       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       y       -       -       smtp
relay     unix  -       -       y       -       -       smtp
  -o syslog_name=postfix/relay
showq     unix  n       -       y       -       -       showq
error     unix  -       -       y       -       -       error
retry     unix  -       -       y       -       -       error
discard   unix  -       -       y       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       y       -       1       anvil
scache    unix  -       -       y       -       1       scache
